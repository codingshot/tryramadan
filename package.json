{
  "name": "tryramadan-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.13.0" },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "npm run dev -w @tryramadan/web",
    "dev:mobile": "npm run start -w @tryramadan/mobile",
    "dev:universal": "npm run web -w @tryramadan/mobile",
    "build": "npm run build -w @tryramadan/web",
    "build:universal": "npm run build -w @tryramadan/mobile",
    "build:all": "npm run build && npm run build:universal",
    "preview": "npm run preview -w @tryramadan/web",
    "test": "npm run test -w @tryramadan/web",
    "test:watch": "npm run test:watch -w @tryramadan/web",
    "test:e2e": "npm run test:e2e -w @tryramadan/web",
    "test:expo": "npm run build:universal && npm run test:expo -w @tryramadan/web",
    "lint": "npm run lint -w @tryramadan/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "guides:screenshots": "npm run guides:screenshots -w @tryramadan/web",
    "generate:webp": "npm run generate:webp -w @tryramadan/web",
    "brand:zip": "npm run brand:zip -w @tryramadan/web"
  }
}
